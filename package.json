{
  "name": "browsebrowsebrowse",
  "version": "0.2.0",
  "description": "Headless Chrome CLI for coding agents. Screenshots, PDFs, rendered HTML/text and page JS from the shell — cold by default, optionally daemonised. Sibling of domdomdom, which does DOM work with no browser at all.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "browsebrowsebrowse": "dist/cli.js",
    "bbb": "dist/cli.js"
  },
  "files": [
    "dist/",
    "skills/",
    ".claude-plugin/",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "test": "bun test test/unit",
    "test:integration": "bun test --config=bunfig.integration.toml test/integration",
    "test:integration:dist": "bun run build && BBB_TEST_DIST=1 bun test --config=bunfig.integration.toml test/integration",
    "typecheck": "tsc --noEmit",
    "quality": "tsc --noEmit && bun test test/unit",
    "release": "bun scripts/release.mjs",
    "build": "bun scripts/build.mjs",
    "smoke:node": "bun scripts/smoke-node.mjs",
    "smoke:pack": "bun scripts/smoke-pack.mjs",
    "version": "bun scripts/sync-plugin-version.mjs && git add .claude-plugin/plugin.json",
    "prepack": "bun run build",
    "prepublishOnly": "bun run quality && bun run smoke:node && bun run smoke:pack"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "license": "MIT",
  "author": "scruffymongrel",
  "homepage": "https://github.com/scruffymongrel/browsebrowsebrowse",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scruffymongrel/browsebrowsebrowse.git"
  },
  "bugs": {
    "url": "https://github.com/scruffymongrel/browsebrowsebrowse/issues"
  },
  "keywords": [
    "headless-chrome",
    "chrome-headless-shell",
    "puppeteer",
    "screenshot",
    "pdf",
    "cli",
    "claude-code",
    "agent-skill",
    "browser-automation",
    "cdp"
  ],
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^25.6.0",
    "typescript": "^5"
  },
  "dependencies": {
    "@puppeteer/browsers": "^3.2.1",
    "puppeteer-core": "^25.9.0"
  }
}
